rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Authorisation model
    //
    // TEACHING is self-service and needs no grant. Anyone signed in can
    // create a cohort; creating it makes them its owner, and owning it is
    // what lets them see their students — the Kahoot/Google Classroom shape.
    // Nobody has to be promoted to "educator" first, which is what made every
    // previous model need an admin, a script, or both.
    //
    // The privacy line that makes that safe is the student's own choice: an
    // educator sees a student only once that student has joined — by typing
    // the cohort's join code, or by accepting an invitation addressed to them
    // — and leaving removes them again. An educator can invite a whole year
    // group at once, but inviting is an offer, not membership. Owning a cohort
    // grants access to the people who opted into it, never to anyone else.
    //
    // ADMIN is still granted, because it is genuinely privileged (every
    // user's data, the Change Register, platform analytics). It comes from a
    // custom claim, a roles/{uid} document written at /admin/people, or the
    // bootstrap owner address below — without that last one no admin could
    // ever exist, since granting admin requires already being one.
    //
    // COST: an educator's read of student data spends up to three extra
    // document reads evaluating the rule (the student's profile, the cohort,
    // and the roles doc when isAdmin is reached). That is the price of
    // ownership-based access at classroom scale.
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') == 'nearyomichael@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true
        || isBootstrapAdmin()
        || (
          exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('admin', false) == true
        )
      );
    }

    // Guarded by exists(): get() on a missing document errors, and a rule that
    // errors denies the request outright — so an attempt whose author has no
    // profile doc would otherwise become unreadable BY ITS OWN AUTHOR.
    function cohortOfUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('cohort', '')
        : '';
    }

    function ownsCohort(cohortId) {
      return isSignedIn() && cohortId is string && cohortId != ''
        && exists(/databases/$(database)/documents/cohorts/$(cohortId))
        && get(/databases/$(database)/documents/cohorts/$(cohortId)).data.get('ownerUid', '') == request.auth.uid;
    }

    // roles/{uid} — admin grants only. Readable by its owner (the route guard
    // needs it) and by admins (the /admin/people list); writable only by an
    // admin, so admin can never be self-issued.
    match /roles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // users/{uid} profile doc, plus every subcollection under it
    // (mastery, questionExposure, sessions) — owner-only for writes, always.
    // Admins get read-only access across every user for the /admin/users
    // screens; never write access, since admin tooling should never be able
    // to alter a student's progress. An educator gets the same read-only
    // access to a student who has joined a cohort THEY own — the requester's
    // own uid is the only input to that check, so access to one class can
    // never be turned into access to another.
    //
    // MEMBERSHIP IS PROVEN, NOT ASSERTED. `cohort` on this document is what
    // every educator-facing rule keys off: ownsCohort() on this document grants
    // an educator read of a student's PROFILE (name, class, last active), and
    // isMemberOfCohort() lets that student write the class's rollup counters.
    // It no longer reaches the subcollections below — see the note there. Until now a student could set
    // it to any value, because the join code was only ever checked in the
    // client — so knowing a cohort id was enough to join a class uninvited and
    // write into its figures.
    //
    // A cohort id is a randomUUID and not guessable, but it is not secret
    // either: it sits in the educator's URL bar and inside every invitation
    // the invitee can read. "Hard to guess" is not the property this needs.
    //
    // So a change to `cohort` must come with evidence — the class's join code,
    // or an invitation addressed to this account. Clearing it never needs
    // evidence, because leaving must always be available and immediate.
    function joinedWithCode(cohortId) {
      return request.resource.data.get('cohortJoinCode', '') != ''
        && exists(/databases/$(database)/documents/cohorts/$(cohortId))
        && get(/databases/$(database)/documents/cohorts/$(cohortId)).data.get('joinCode', '')
             == request.resource.data.get('cohortJoinCode', '');
    }

    function joinedWithInvite(cohortId) {
      return request.resource.data.get('cohortInviteId', '') != ''
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.get('cohortInviteId', '')))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.get('cohortInviteId', ''))).data.cohortId == cohortId
        // Invitations store the address lowercased; a token's email is
        // whatever the identity provider hands back, which may not be.
        && get(/databases/$(database)/documents/invites/$(request.resource.data.get('cohortInviteId', ''))).data.email
             == request.auth.token.get('email', '').lower();
    }

    /** The cohort being written is either absent, or backed by a code or an invitation. */
    function cohortIsProven() {
      return request.resource.data.get('cohort', null) == null
        || joinedWithCode(request.resource.data.get('cohort', null))
        || joinedWithInvite(request.resource.data.get('cohort', null));
    }

    // ---------------------------------------------------------------------
    // users/{uid}.freeArea — which ONE area the free tier opens
    // (docs/DESIGN-CONTENT-BEHIND-SERVER.md, step 1).
    //
    // It used to live on the device, where clearing storage bought a fresh
    // choice and unlimited changes (paywall trace finding 7), and where the
    // content function could not see it at all. Here the rule the app has
    // always stated is the rule the database keeps:
    //
    //   - chosen once;
    //   - changed once, no sooner than 30 days after it was chosen;
    //   - nothing else, ever. Not removed, not re-timed, not re-counted.
    //
    // Stored as { area, chosenAt, switches }.
    //
    // `chosenAt` MUST BE THE SERVER'S CLOCK (request.time, which is what a
    // client's serverTimestamp() becomes). A client that could write its own
    // date would backdate the first pick by a month and change area the same
    // minute. That is also why moving a device's old choice up here cannot
    // carry its old date: the wait restarts on the day it is moved. The honest
    // student waits a little longer; the dishonest one gains nothing.
    //
    // `switches` may START at 1. A device whose one change was already used
    // moves up as used. Starting at 1 only ever takes a change away, so there
    // is nothing to gain by claiming it.
    //
    // The area list is repeated from types/region.ts AREAS because rules can
    // import nothing; freeAreaRules.test.ts fails if the two drift, and so
    // does the 30 against FREE_AREA_SWITCH_DAYS.
    //
    // WHAT THIS DOES NOT STOP: deleting the profile and creating it again
    // (the owner may delete, for erasure), or simply opening a second
    // account. Both give a fresh choice. See docs/CONTENT-SERVER-STATUS.md.
    // ---------------------------------------------------------------------
    function isArea(area) {
      return area in ['shoulder', 'elbow', 'wrist-hand', 'hip', 'knee', 'ankle-foot',
        'cervical-spine', 'thoracic-spine', 'lumbar-spine'];
    }

    /** A well-formed choice, stamped with the server's time of this very write. */
    function isFreshFreeArea(choice) {
      return choice is map
        && choice.keys().hasOnly(['area', 'chosenAt', 'switches'])
        && choice.keys().hasAll(['area', 'chosenAt', 'switches'])
        && isArea(choice.area)
        && choice.chosenAt == request.time
        && choice.switches is int;
    }

    /** The first pick: nothing stored before, and no change claimed beyond the one allowed. */
    function isFirstFreeArea(choice) {
      return isFreshFreeArea(choice) && (choice.switches == 0 || choice.switches == 1);
    }

    /** The one change: a different area, the count going 0 -> 1, thirty days on. */
    function isFreeAreaSwitch(before, after) {
      return isFreshFreeArea(after)
        && before is map
        && before.get('switches', -1) == 0
        && after.switches == 1
        && after.area != before.get('area', '')
        && before.get('chosenAt', null) is timestamp
        && request.time >= before.chosenAt + duration.value(30, 'd');
    }

    function freeAreaWriteIsAllowed() {
      let before = resource.data.get('freeArea', null);
      let after = request.resource.data.get('freeArea', null);
      return after == before
        || (before == null && isFirstFreeArea(after))
        || (before != null && isFreeAreaSwitch(before, after));
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      // CREATE MUST PIN ENTITLEMENT TOO. Update below keeps `entitlement`
      // byte-identical, but create had no such check — and owners may delete
      // their own document — so any signed-in account, anonymous included,
      // could create (or delete and recreate) it carrying
      // {tier: 'institutional', expiresAt: null} and unlock everything. Found
      // by the 29 Sep paywall trace. A new document never carries an
      // entitlement from the client; only the webhook or an admin sets one.
      //
      // A free area may arrive with the new document (a guest who picks at
      // onboarding before any profile exists), held to the same first-pick
      // rule as one added later.
      allow create: if isSignedIn() && request.auth.uid == uid && cohortIsProven()
        && !('entitlement' in request.resource.data)
        && !('contentFetch' in request.resource.data)
        && (!('freeArea' in request.resource.data) || isFirstFreeArea(request.resource.data.freeArea));
      // Unchanged is always allowed, so the ordinary profile write on every
      // sign-in (displayName, lastActiveAt) never pays for a cohort lookup.
      //
      // ENTITLEMENT IS NEVER CLIENT-WRITABLE (CR-027). A paywall a user can
      // lift by editing their own document is decoration, so `entitlement`
      // must be byte-identical across an update: only a payment webhook or an
      // admin, both running through the Admin SDK and bypassing these rules
      // entirely, may set it. The comparison is on the whole map rather than
      // on `tier`, because a client that could change `expiresAt` alone would
      // have every bit as much free access as one that could change the tier.
      //
      // Absent on both sides compares equal, so this costs an account that has
      // never bought anything nothing at all.
      //
      // `freeArea` follows its own rule above. `contentFetch` is the content
      // function's count of how many areas this account has fetched in the
      // last hour (netlify/functions/content-area.ts), written through the
      // Admin SDK; a client that could reset it would have no limit.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.get('entitlement', null) == resource.data.get('entitlement', null)
        && request.resource.data.get('contentFetch', null) == resource.data.get('contentFetch', null)
        && freeAreaWriteIsAllowed()
        && (
          request.resource.data.get('cohort', null) == resource.data.get('cohort', null)
          || cohortIsProven()
        );
      // Erasure — see data/accountLifecycle.ts.
      allow delete: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
      allow read: if ownsCohort(resource.data.get('cohort', ''));

      // Subcollections: mastery, questionExposure, sessions.
      //
      // NO COHORT-OWNER READ. There was one, and it was the other half of the
      // grant CR-031 removed from attemptEvents — missed at the time because
      // the obvious leak was the answer log. It let a class owner read every
      // session summary of every student in their class, and a session summary
      // carries missedStructureIds, startedAt and finishedAt: what you got
      // wrong and when you were working, per session.
      //
      // The privacy policy tells students "not the questions you got wrong one
      // by one, not when you answered", and says in terms that this is enforced
      // by these rules rather than by what the UI renders. That was not true
      // while this grant existed, and a promise about rules has to be kept by
      // the rules.
      //
      // Nothing was using it: every educator read is against the users/{uid}
      // DOCUMENT above (displayName, cohort, lastActiveAt), and the dashboard's
      // figures come from cohorts/{id}/studentStats, aggregated on the
      // student's own device. See educator/data/cohortRollups.ts.
      //
      // `/{sub}/{document=**}`, NOT `/{document=**}`. Under rules_version 2 a
      // recursive wildcard matches ZERO or more segments, so the bare form
      // also matched users/{uid} itself — and because rules OR together, its
      // unconditional owner write overrode every check on the document above:
      // any account could grant itself an entitlement or join any cohort
      // uninvited. Found 30 Sep by rules-tests/firestore.rules.test.ts, the
      // first time these rules were run rather than read. The {sub} segment
      // makes this match subcollections only.
      match /{sub}/{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
        allow read: if isAdmin();
      }
    }

    // Top-level, append-only event log — lives outside users/{uid} because
    // cross-user analytics needs to query across owners, which Firestore
    // cannot do over a per-user subcollection.
    //
    // APPEND-ONLY, WITH ONE EXCEPTION. No update rule exists and none should:
    // an answer that can be rewritten is not a record of anything. Delete is
    // granted to the author alone, and only because the right to erasure
    // outranks our preference for an immutable log — the privacy policy
    // promises a student can delete their account, and an answer log that
    // survived that would make the promise false. data/accountLifecycle.ts is
    // the only caller.
    match /attemptEvents/{attemptId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
      // NO cohort-owner read (CR-031). This grant used to exist, and it is why
      // the join notice could not promise that an educator never sees your
      // individual answers — it let a class owner read every attemptEvent of
      // every student in their class, selectedAnswer included, and
      // cohortAnalytics pulled those rows into their browser to aggregate
      // client-side. Educators now read the counters under
      // cohorts/{id}/studentStats and confusionStats instead,
      // written on the student's own device. See educator/data/cohortRollups.ts.
    }

    // invites/{emailKey__cohortId} — a pending offer of membership, never
    // membership itself.
    //
    // An educator with a year group should not have to chase forty people to
    // type a code, but adding students directly would make three things false
    // at once: this file's own claim that an educator sees a student only
    // once that student joined, the join notice, and the privacy policy. So
    // the educator does the bulk work and the student still consents.
    //
    // AN UNACCEPTED INVITE IS NOT STUDENT DATA. It holds an email address the
    // educator already had and the name of their own class. Nothing about the
    // student's performance is reachable until they accept, at which point
    // users/{uid}.cohort is set by the student's own device — the same write
    // joining by code performs.
    //
    // The read rule compares against the caller's verified token, so a query
    // for somebody else's address is refused outright rather than returning
    // nothing: Firestore evaluates this per document, and a single row the
    // caller may not read fails the whole query.
    match /invites/{inviteId} {
      allow read: if isSignedIn() && (
        request.auth.token.get('email', '').lower() == resource.data.email
        || ownsCohort(resource.data.cohortId)
        || isAdmin()
      );
      // Only the owner of the named cohort may offer membership of it, and
      // only for a cohort they own — checked against the request's own data
      // so a cohort id cannot be swapped in after the fact.
      allow create: if ownsCohort(request.resource.data.cohortId)
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;
      // Revoked by the educator, declined or accepted by the invitee.
      allow delete: if isSignedIn() && (
        request.auth.token.get('email', '').lower() == resource.data.email
        || ownsCohort(resource.data.cohortId)
        || isAdmin()
      );
      // An invitation that could be edited could be repointed at another
      // cohort after the invitee had seen which class they were joining.
      allow update: if false;
    }

    // joinCodes/{CODE} — the code IS the document id, which is what makes a
    // code unique: Firestore's create fails if the document already exists,
    // so two people generating the same code is settled by the database
    // rather than by a client-side check that can race.
    //
    // It exists as its own collection so a student can resolve a code with a
    // single get() by id, without being able to LIST cohorts. Reading the
    // cohorts collection with a `where joinCode ==` query would have meant
    // granting list access to every class on the platform, which is an
    // enumeration of every join code.
    //
    // Immutable once written (no update): a code that could be repointed at a
    // different cohort would silently redirect students mid-term.
    match /joinCodes/{code} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.get('ownerUid', '') == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // cohorts/{cohortId} — anyone signed in can create one and thereby own
    // it. `get` is open to any signed-in user because a student needs to read
    // the cohort they have joined, and the id is an unguessable uuid reached
    // only through a join code they were given. `list` is restricted to your
    // own cohorts (or an admin's), so the collection cannot be enumerated.
    // -------------------------------------------------------------------
    // Cohort rollups (CR-031). What an educator reads instead of student rows.
    //
    // confusionStats is a COUNTER set — no uid, no timestamp, no document
    // per answer — so there is nothing in it to correlate back to a person,
    // even for someone reading the raw database. Anonymised event rows would
    // not achieve that: in a class of forty, timing re-identifies.
    //
    // studentStats IS per-student, and that is the point: name, accuracy and
    // last-active are exactly what the join notice has always said a module
    // leader sees. Its structures and days maps are what the cohort-wide
    // tables are summed from, so there is no separate per-structure
    // collection — see educator/data/cohortRollups.ts.
    //
    // Writes come from the student's own device, so they are constrained to
    // members of that cohort. The residual risk is integrity, not privacy — a
    // determined student could inflate their own class's counters. That is a
    // far smaller problem than an educator reading everyone's answers, and it
    // goes away entirely if these move to a Cloud Function later.
    // -------------------------------------------------------------------
    function isMemberOfCohort(cohortId) {
      return isSignedIn() && cohortOfUser(request.auth.uid) == cohortId;
    }

    match /cohorts/{cohortId}/confusionStats/{pairKey} {
      allow read: if isAdmin() || ownsCohort(cohortId);
      // Students only. The backfill that rebuilds these runs through the
      // Admin SDK (src/scripts/backfillCohortRollups.ts), which bypasses rules
      // entirely — so there is no reason to widen who may write derived
      // student data here, permanently, for a migration that runs once.
      allow write: if isMemberOfCohort(cohortId);
    }

    match /cohorts/{cohortId}/studentStats/{uid} {
      allow read: if isAdmin() || ownsCohort(cohortId);
      // Your own row only — a student cannot write another's totals, which is
      // what stops one member rewriting a classmate's accuracy. No admin
      // grant, for the reason given above.
      allow write: if isMemberOfCohort(cohortId) && request.auth.uid == uid;
    }

    match /cohorts/{cohortId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || (isSignedIn() && resource.data.get('ownerUid', '') == request.auth.uid);

      // `licensedUntil` is refused at creation for the reason it is pinned on
      // update below: it opens every region for every member. Without this, an
      // account could create a class licensed to 2099 and join it with its own
      // code (29 Sep paywall trace). Only an admin sets a licence.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.joinCode is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && !('licensedUntil' in request.resource.data);

      // Ownership is pinned on update: a cohort that could be reassigned would
      // hand another account every student who joined it.
      //
      // `licensedUntil` is pinned for the same reason `entitlement` is pinned
      // on a user (CR-027): it opens every region for every member, so a
      // course lead who could set it on their own cohort could licence their
      // whole university for nothing. Only an admin, through the Admin SDK,
      // writes it — see scripts/accountData.ts licence.
      allow update: if (ownsCohort(cohortId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.get('licensedUntil', null) == resource.data.get('licensedUntil', null))
        || isAdmin();
      allow delete: if ownsCohort(cohortId) || isAdmin();

      // Assignments: visible to any signed-in user (so a student could in
      // principle see what is set), writable only by the cohort's owner.
      match /assignments/{assignmentId} {
        allow read: if isSignedIn();
        allow write: if ownsCohort(cohortId) || isAdmin();
      }
    }

    // settings/site — runtime switches for the public site, currently just
    // whether the marketing home page is shown.
    //
    // Readable by anyone, including a visitor who has not signed in at all:
    // the page it controls is the first thing a stranger sees, so requiring
    // auth to decide whether to show it would defeat the purpose. It holds no
    // personal data and nothing an attacker gains by reading.
    //
    // Writable only by an admin, because it decides what the front door of the
    // product is.
    match /settings/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-only Change Register backlog (see src/features/admin). Regular
    // users get no access at all — this is the enforcement the client-side
    // <RequireAdmin> route guard depends on; the guard alone is not security.
    match /changeRequests/{ref} {
      allow read, write: if isAdmin();
    }

    // Admin-only "reviewed" markers for the Question Health screen (CR-005) —
    // keyed by questionId, so a reviewed question doesn't keep resurfacing in
    // the flagged list. Same admin-only shape as changeRequests.
    match /questionReviews/{questionId} {
      allow read, write: if isAdmin();
    }

    // Payments that verified but could not be written (paddle-webhook.ts).
    // Written by the Admin SDK, which bypasses these rules, and read by
    // scripts/accountData.ts. Closed to every client, including an admin's
    // browser: each record names an account and what it should have been
    // granted, and nothing in the app has a reason to read it.
    match /billingFailures/{eventId} {
      allow read, write: if false;
    }
  }
}
