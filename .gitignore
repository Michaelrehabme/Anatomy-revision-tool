node_modules
dist
dist-ssr
*.local
.env
.env.local
coverage
.DS_Store
*.log

# Local Netlify folder
.netlify

# Derived working files, not source content
/atlas-panel-exports

# Blender source model, render output and the bundled prototype viewer (~2GB).
# Renders that ship with the app are copied into public/anatomy/ instead.
#
# Leading slashes matter: these are repo-root directories only. Unanchored
# "atlas/" also matches public/anatomy/atlas/, which silently stopped the app's
# own atlas slides from being committed.
/atlas/
/renders/
/deploy/
/tools/
dist-demo

# Regenerable intermediate, same as hotspots.regions.json: traced from renders
# by jointLineHotspots.ts, then converted into the seed.
joint-lines.hotspots.json
joint-lines.hotspots.v2.json

# Review payloads: a packer script rebuilds them from renders/ and the seed,
# and each carries its pictures inlined as data URIs, so they are megabytes of
# derived bytes with no source value. Untracked they also block `npm run
# deploy`, which refuses a dirty tree.
*.data.json
*.data.js
locate-target-preview.html

# Python bytecode from the Blender scripts
__pycache__/
*.pyc
landmark-region-preview.html
landmark-region-probe.json
