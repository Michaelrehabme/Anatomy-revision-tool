# Persistence backend: "local" (default, uses localStorage, no Firebase project needed)
# or "firestore" (requires a real Firebase project + the config values below).
VITE_PERSISTENCE=local

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Paddle checkout (CR-033 item 11). All four are needed, or /pricing shows the
# plans with checkout switched off. The client token is public by design
# (test_… for sandbox, live_… for production). The API key and the webhook
# secret are NOT: they belong in Netlify's environment with no VITE_ prefix.
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_MONTHLY=
VITE_PADDLE_PRICE_ANNUAL=
